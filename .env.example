# Copy this file to .env and adjust locally. Never commit .env.

# Backend
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB — start a local mongod, then the API stores demo child + module state.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=wisecub
JWT_SECRET=replace-with-a-long-random-local-secret

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000
